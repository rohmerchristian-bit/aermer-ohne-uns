---
import { url } from '../lib/paths.ts';
import { formatEuro } from '../lib/format.ts';
import { SAVINGS_REFERATE, SAVINGS_YEARS, savingsList, type SavingsMeasure } from '../data/savings-list.ts';

// The complete savings list in a framed box: one collapsible group per department,
// showing the years 2027–2029. 2026 and 2030 are in the original PDF.
const SHOWN_YEARS = [2027, 2028, 2029] as const;
const yearIndex = (year: (typeof SAVINGS_YEARS)[number]) => SAVINGS_YEARS.indexOf(year);

/** Official sums leave out amounts that only apply under a condition. */
const sum = (measures: SavingsMeasure[], year: (typeof SAVINGS_YEARS)[number]) =>
  measures.reduce((total, m) => total + (m.conditions?.[year] ? 0 : m.amounts[yearIndex(year)]), 0);

const groups = SAVINGS_REFERATE.map((ref) => {
  const measures = savingsList.filter((m) => m.referat === ref.id);
  return { ...ref, measures, sums: SHOWN_YEARS.map((y) => sum(measures, y)) };
});
const totals = SHOWN_YEARS.map((y) => sum(savingsList, y));
const amountText = (value: number) => (value === 0 ? '–' : formatEuro(value));
---

<div class="savings">
  <div class="savings__bar">
    <p class="label">Sparliste der Stadtverwaltung · Ergebnishaushalt</p>
    <p class="label">{savingsList.length} Maßnahmen</p>
  </div>

  <div class="savings__head" aria-hidden="true">
    <span>Referat</span>
    {SHOWN_YEARS.map((y) => <span class="savings__num">{y}</span>)}
  </div>

  {
    groups.map((group) => (
      <details class="ref">
        <summary class="ref__summary">
          <span class="ref__title">
            <span class="ref__name">Referat {group.id}</span>
            {group.name && <span class="ref__area">{group.name}</span>}
            <span class="ref__count">{group.measures.length} Maßnahmen</span>
          </span>
          {group.sums.map((value, i) => (
            <span class="savings__num ref__sum" data-year={SHOWN_YEARS[i]}>
              {amountText(value)}
            </span>
          ))}
          <span class="ref__toggle" aria-hidden="true" />
        </summary>

        <table class="measures">
          <caption class="visually-hidden">
            Einsparmöglichkeiten Referat {group.id}
          </caption>
          <thead>
            <tr>
              <th scope="col">Maßnahme</th>
              <th scope="col">Umsetzbar ab</th>
              {SHOWN_YEARS.map((y) => (
                <th scope="col" class="savings__num">
                  {y}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {group.measures.map((m) => (
              <>
                {m.groupNote && (
                  <tr class="measures__group-note">
                    <td colspan={2 + SHOWN_YEARS.length}>{m.groupNote}</td>
                  </tr>
                )}
                <tr>
                  <td class="measures__title">
                    <span class="measures__ref">
                      Amt {m.amt} · Nr. {m.nr}
                    </span>
                    <strong>{m.title}</strong>
                    {m.note && <span class="measures__note">{m.note}</span>}
                  </td>
                  <td class="measures__start" data-label="ab">
                    {m.start || '–'}
                  </td>
                  {SHOWN_YEARS.map((y) => (
                    <td class="savings__num" data-label={y}>
                      {amountText(m.amounts[yearIndex(y)])}
                      {m.conditions?.[y] && <span class="measures__condition">{m.conditions[y]}</span>}
                    </td>
                  ))}
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </details>
    ))
  }

  <div class="savings__total">
    <span class="ref__name">Gesamt</span>
    {
      totals.map((value, i) => (
        <span class="savings__num" data-year={SHOWN_YEARS[i]}>
          {formatEuro(value)}
        </span>
      ))
    }
  </div>
</div>

<p class="savings__source small">
  Quelle: Stadt Erlangen, „Übersicht Einsparmöglichkeiten – Ergebnishaushalt“. Beträge in Euro pro Jahr; Beträge mit
  Bedingung zählen nicht zur Summe. Die Jahre 2026 und 2030 stehen im Original:{' '}
  <a href={url('/downloads/sparliste-ergebnishaushalt.pdf')} download>Sparliste als PDF herunterladen (300 KB)</a>
</p>

<style>
  .savings {
    --cols: minmax(0, 1fr) repeat(3, 8.5rem) 2rem;
    border: var(--line-strong) solid var(--color-ink);
    box-shadow: calc(var(--offset) * 2) calc(var(--offset) * 2) 0 var(--color-ink);
    background: var(--color-paper);
  }

  .savings__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-ink);
    color: var(--color-signal);
  }

  .savings__head,
  .ref__summary,
  .savings__total {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
  }

  .savings__head {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-bottom: var(--line-strong) solid var(--color-ink);
  }

  .savings__num {
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  .ref {
    border-bottom: var(--line) solid var(--color-ink);
  }

  .ref__summary {
    cursor: pointer;
    list-style: none;
    padding-block: var(--space-4);
  }

  .ref__summary::-webkit-details-marker {
    display: none;
  }

  .ref__summary:hover,
  .ref[open] > .ref__summary {
    background: var(--color-signal);
    color: var(--color-signal-text, var(--color-ink));
  }

  .ref__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .ref__name {
    font-size: var(--fs-h3);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: 1.1;
  }

  .ref__area {
    font-weight: 800;
  }

  .ref__count {
    font-size: var(--fs-small);
  }

  .ref__sum {
    font-weight: 800;
  }

  /* Plus that turns into a minus when open */
  .ref__toggle {
    position: relative;
    justify-self: end;
    align-self: center;
    width: 1.25rem;
    height: 1.25rem;
  }

  .ref__toggle::before,
  .ref__toggle::after {
    content: '';
    position: absolute;
    inset: calc(50% - var(--line-strong) / 2) 0 auto;
    height: var(--line-strong);
    background: currentColor;
    transition: transform var(--duration-fast) ease-out;
  }

  .ref__toggle::after {
    transform: rotate(90deg);
  }

  .ref[open] .ref__toggle::after {
    transform: rotate(0deg);
  }

  .measures {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    border-top: var(--line) solid var(--color-ink);
  }

  .measures thead {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
  }

  .measures th,
  .measures td {
    padding: var(--space-3) var(--space-4);
    vertical-align: top;
  }

  .measures th {
    border-bottom: var(--line) solid var(--color-ink);
  }

  .measures tbody tr + tr td {
    border-top: 1px solid var(--color-muted);
  }

  .measures__title {
    display: grid;
    gap: var(--space-1);
    max-width: 52rem;
  }

  .measures__ref {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .measures__note {
    color: var(--color-muted);
  }

  .measures__start {
    min-width: 7rem;
  }

  .measures .savings__num {
    width: 8.5rem;
  }

  .measures__condition {
    display: block;
    font-size: var(--fs-label);
    white-space: normal;
    color: var(--color-muted);
  }

  .measures__group-note td {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .savings__total {
    padding-block: var(--space-4);
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 900;
  }

  .savings__source {
    margin-top: var(--space-5);
  }

  /* Phones: the year columns move under the department name, table rows become cards */
  @media (max-width: 47.99em) {
    .savings__head {
      display: none;
    }

    .ref__summary,
    .savings__total {
      grid-template-columns: repeat(3, minmax(0, 1fr)) 1.5rem;
      row-gap: var(--space-2);
    }

    .ref__title,
    .savings__total > .ref__name {
      grid-column: 1 / -1;
    }

    .ref__toggle {
      grid-row: 1;
      grid-column: 4;
    }

    .ref__title {
      grid-column: 1 / 4;
    }

    .ref__sum,
    .savings__total .savings__num {
      text-align: left;
      font-size: var(--fs-small);
      white-space: normal;
    }

    .ref__sum::before,
    .savings__total .savings__num::before {
      content: attr(data-year);
      display: block;
      font-size: var(--fs-label);
      font-weight: 700;
      letter-spacing: var(--tracking-label);
    }

    .measures thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .measures tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2) var(--space-3);
      padding: var(--space-3) var(--space-4);
    }

    .measures tbody tr + tr {
      border-top: 1px solid var(--color-muted);
    }

    .measures tbody tr + tr td,
    .measures th,
    .measures td {
      padding: 0;
      border: 0;
    }

    .measures__title,
    .measures__start,
    .measures__group-note td {
      grid-column: 1 / -1;
    }

    .measures__group-note {
      background: var(--color-ink);
    }

    .measures .savings__num {
      width: auto;
      text-align: left;
      white-space: normal;
    }

    .measures [data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: var(--fs-label);
      font-weight: 700;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .measures__start::before {
      display: inline !important;
      margin-right: var(--space-2);
    }
  }
</style>
