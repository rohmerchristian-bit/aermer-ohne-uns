---
import { srcsetUrl, url } from '../lib/paths.ts';
import type { Project } from '../data/types.ts';
import { getArea } from '../data/areas.ts';
import { getOrganisation, projectsOf } from '../data/index.ts';
import { AMOUNT_YEAR } from '../data/budget.ts';
import { formatCut, initials, truncate } from '../lib/format.ts';
import { amountSourceLabel, percentLabel } from '../lib/amount-label.ts';
import IconFlip from './icons/IconFlip.astro';
import IconArrow from './icons/IconArrow.astro';
import IconExternal from './icons/IconExternal.astro';

// One affected project = one tile.
interface Props {
  project: Project;
  /** Heading level of the project name, so the tile fits the page outline. */
  headingLevel?: 2 | 3 | 4;
  /** Static demo state for the styleguide: render the back side. */
  flipped?: boolean;
  /** Keeps element ids unique when the same project appears twice on a page. */
  idSuffix?: string;
}

const { project: p, headingLevel = 3, flipped = false, idSuffix = '' } = Astro.props;
const area = getArea(p.area);
const id = `tile-${p.id}${idSuffix}`;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

const CONSEQUENCES_MAX = 280;
// The quote is never cut; longer quotes get a smaller type size instead.
const quoteSize = !p.quote ? null : p.quote.length > 220 ? 'small' : p.quote.length > 130 ? 'medium' : null;
// Tile width per breakpoint (see .tile-grid in src/styles/layout.css).
const IMAGE_SIZES = '(min-width: 96em) 22rem, (min-width: 64em) 30vw, (min-width: 40em) 46vw, 92vw';

const showOrg = p.name !== p.orgName;
const notes = [percentLabel(p.amountPercent), amountSourceLabel(p)].filter(Boolean).join(' · ');
const orgWebsite = getOrganisation(p.orgSlug)?.website ?? null;
const externalUrl = p.infoLink ?? orgWebsite;
const externalLabel = p.infoLink ? 'Stellungnahme' : 'Website';
const fullName = showOrg ? `${p.name} (${p.orgName})` : p.name;
// With one project the organisation page starts with its details and contact, so link to the top;
// with several, jump to this project (which links back up to the contact details).
const detailHref = url(`/einrichtungen/${p.orgSlug}/${projectsOf(p.orgSlug).length > 1 ? `#${p.anchor}` : ''}`);
---

<article
  class:list={['tile', { 'is-flipped': flipped }]}
  data-area={area.slug}
  data-tile
  aria-labelledby={`${id}-name`}
>
  <div class="tile__card">
    <div class="tile__face tile__front" id={`${id}-front`} data-tile-front>
      <p class="tile__area label">{area.label}</p>
      <Heading class="tile__name" id={`${id}-name`}>{p.name}</Heading>
      {showOrg && <p class="tile__project">{p.orgName}</p>}

      <div class="tile__money">
        {
          p.amount !== null ? (
            <div class="tile__dated">
              <p class="tile__year">
                <span class="tile__year-label">Kürzung</span>
                <span class="tile__year-value">{AMOUNT_YEAR}</span>
              </p>
              <p class="tile__amount">
                <span class:list={['tile__amount-value', { 'tile__amount-value--long': p.amount >= 1_000_000 }]}>
                  {formatCut(p.amount)}
                </span>
              </p>
            </div>
          ) : p.nonMonetary ? (
            <p class="tile__amount tile__amount--text">{p.nonMonetary}</p>
          ) : (
            <p class="tile__amount tile__amount--pending">Betrag folgt</p>
          )
        }
        {notes && <p class="tile__source">{notes}</p>}
      </div>

      <button
        type="button"
        class="tile__flip"
        aria-expanded={flipped ? 'true' : 'false'}
        aria-controls={`${id}-back`}
        data-tile-open
      >
        <span class="tile__hint label">Umdrehen <IconFlip /></span>
        <span class="visually-hidden">: Folgen, Zitat und Links zu {fullName} anzeigen</span>
      </button>
    </div>

    <div class="tile__face tile__back" id={`${id}-back`} data-tile-back>
      <figure class="tile__media">
        {
          p.image ? (
            <picture class:list={['tile__picture', `tile__picture--${p.image.kind}`]}>
              {p.image.sources.map((source) => (
                <source type={source.type} srcset={srcsetUrl(source.srcset)} sizes={IMAGE_SIZES} />
              ))}
              <img
                src={url(p.image.src)}
                width={p.image.width}
                height={p.image.height}
                alt={p.image.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : (
            <div class="tile__placeholder" aria-hidden="true">
              {initials(p.orgName)}
            </div>
          )
        }
        {
          p.image?.credit && (
            <figcaption class="tile__credit">
              {p.image.kind === 'logo' ? 'Bild' : 'Foto'}: {p.image.credit}
            </figcaption>
          )
        }
      </figure>

      <div class="tile__back-body">
        {
          p.quote && (
            <blockquote class:list={['tile__quote', quoteSize && `tile__quote--${quoteSize}`]}>
              <p>„{p.quote}“</p>
            </blockquote>
          )
        }
        {p.consequences && <p class="tile__consequences">{truncate(p.consequences, CONSEQUENCES_MAX)}</p>}
      </div>

      <ul class="tile__links" role="list">
        <li>
          <a href={detailHref}>
            Mehr erfahren <IconArrow />
            <span class="visually-hidden"> über {fullName}</span>
          </a>
        </li>
        {
          externalUrl && (
            <li>
              <a href={externalUrl} target="_blank" rel="noopener">
                {externalLabel} <IconExternal />
                <span class="visually-hidden"> von {p.orgName} (externer Link, öffnet in neuem Tab)</span>
              </a>
            </li>
          )
        }
      </ul>

      <button type="button" class="tile__close label" aria-controls={`${id}-front`} data-tile-close>
        Zurück<span class="visually-hidden"> zur Vorderseite von {fullName}</span>
      </button>
    </div>
  </div>
</article>

<script>
  import { initTiles } from '../scripts/tile-flip.ts';
  initTiles();
</script>

<style>
  .tile {
    --tile-pad: clamp(1.125rem, 6cqi, 1.75rem);
    container-type: inline-size;
    position: relative;
    height: var(--tile-height);
    perspective: 1800px;
  }

  .tile__card {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--duration-flip) var(--ease-flip);
  }

  .tile.is-flipped .tile__card {
    transform: rotateY(180deg);
  }

  .tile__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* The hidden face is removed from the accessibility tree and tab order via visibility,
     switched exactly when the card passes its edge. */
  .tile__front {
    visibility: visible;
    transition: visibility 0s;
  }

  .tile.is-flipped .tile__front {
    visibility: hidden;
    transition: visibility 0s linear var(--duration-flip);
  }

  .tile__back {
    transform: rotateY(180deg);
    visibility: hidden;
    transition: visibility 0s linear var(--duration-flip);
  }

  .tile.is-flipped .tile__back {
    visibility: visible;
    transition: visibility 0s;
  }

  /* ---------- Front ---------- */

  .tile__front {
    padding: var(--tile-pad);
    gap: var(--space-3);
    background: var(--area-bg);
    color: var(--area-fg);
    --focus-color: var(--color-ink);
  }

  .tile__name {
    font-size: clamp(1.625rem, 9cqi, 2.5rem);
    font-weight: 900;
    line-height: 0.98;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .tile__project {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .tile__money {
    margin-top: auto;
    padding-bottom: 2.75rem;
  }

  .tile__amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .tile__amount-value {
    font-size: clamp(2.75rem, 17cqi, 4.75rem);
    white-space: nowrap;
  }

  .tile__amount-value--long {
    font-size: clamp(2.25rem, 13cqi, 3.75rem);
  }

  /* Year tab: sits on the rule above the amount like the tab of a filing card, in inverted tile colours. */
  .tile__year {
    display: inline-flex;
    align-items: stretch;
    background: currentColor;
    line-height: 1;
  }

  .tile__year > span {
    color: var(--area-bg);
    padding: 0.3rem 0.5rem 0.25rem;
  }

  .tile__year-label {
    align-self: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .tile__year-value {
    border-left: var(--line) solid var(--area-bg);
    font-size: 1.125rem;
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .tile__dated .tile__amount {
    padding-top: var(--space-2);
    border-top: var(--line-strong) solid currentColor;
  }

  .tile__amount--text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    font-size: clamp(1.625rem, 9cqi, 2.25rem);
    line-height: 1;
  }

  .tile__amount--pending {
    font-size: clamp(2rem, 12cqi, 3rem);
  }

  .tile__source {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The flip button covers the whole front, so a click or tap anywhere turns the card. */
  .tile__flip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--tile-pad);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tile__flip:focus-visible {
    outline-offset: -8px;
  }

  .tile__hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: 2px;
    border-bottom: var(--line) solid currentColor;
  }

  .tile__hint .icon {
    width: 1.25em;
    height: 1.25em;
    transition: transform var(--duration-fast) ease-out;
  }

  .tile__flip:hover .tile__hint .icon {
    transform: rotate(90deg);
  }

  /* ---------- Back ---------- */

  .tile__back {
    background: var(--color-paper);
    color: var(--color-ink);
    border: var(--line-strong) solid var(--color-ink);
  }

  .tile__media {
    position: relative;
    flex: none;
    height: 32%;
    background: var(--area-bg);
  }

  .tile__picture,
  .tile__picture img {
    width: 100%;
    height: 100%;
  }

  .tile__picture--photo img {
    object-fit: cover;
  }

  /* Logos are never cropped: shown whole on white. */
  .tile__picture--logo {
    padding: var(--space-4);
    background: var(--color-white);
  }

  .tile__picture--logo img {
    object-fit: contain;
  }

  .tile__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--area-fg);
    font-size: clamp(3.5rem, 26cqi, 7rem);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .tile__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 100%;
    padding: 0.2rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile__back-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
    padding: var(--space-4) var(--tile-pad) var(--space-2);
    /* If a long quote and the consequences do not fit, the text scrolls instead of being cut. */
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .tile__quote {
    font-size: 1.25rem;
    font-weight: 800;
    font-stretch: var(--stretch-semi);
    line-height: 1.15;
  }

  .tile__quote--medium {
    font-size: 1.0625rem;
  }

  .tile__quote--small {
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .tile__quote,
  .tile__consequences {
    flex: none;
  }

  .tile__consequences {
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .tile__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: auto 0 0;
    padding: var(--space-4) var(--tile-pad);
    padding-right: 6rem;
    list-style: none;
    font-weight: 800;
    font-stretch: var(--stretch-semi);
  }

  .tile__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tile__close {
    position: absolute;
    right: 0;
    bottom: 0;
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    border: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    cursor: pointer;
    --focus-color: var(--color-ink);
  }

  /* Reduced motion: plain cross-fade instead of the 3D turn. */
  @media (prefers-reduced-motion: reduce) {
    .tile__card,
    .tile.is-flipped .tile__card {
      transform: none;
      transition: none;
    }

    .tile__back {
      transform: none;
    }

    /* Visible face: fades in, becomes visible at once. */
    .tile .tile__front,
    .tile.is-flipped .tile__back {
      opacity: 1;
      transition:
        opacity 0.2s linear,
        visibility 0s;
    }

    /* Hidden face: fades out, leaves the accessibility tree after the fade. */
    .tile .tile__back,
    .tile.is-flipped .tile__front {
      opacity: 0;
      transition:
        opacity 0.2s linear,
        visibility 0s linear 0.2s;
    }

    .tile__hint .icon {
      transition: none;
    }
  }
</style>
