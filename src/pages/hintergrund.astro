---
import Page from '../layouts/Page.astro';
import BudgetFacts from '../components/BudgetFacts.astro';
import Timeline from '../components/Timeline.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { budgetDetails } from '../data/budget.ts';
import { count, organisationCount, projectCount, projects, settings, totalAmount } from '../data/index.ts';
import { formatEuro } from '../lib/format.ts';
import { pageCardAlt, shareImagePath } from '../data/share.ts';

const withAmount = projects.filter((p) => p.amount !== null);
const verified = withAmount.filter((p) => p.amountKind === 'verified').length;
---

<Page
  title="Worum es geht"
  ogImage={shareImagePath('hintergrund')}
  ogImageAlt={pageCardAlt('hintergrund')}
  description="Die offiziellen Zahlen zur Haushaltskonsolidierung der Stadt Erlangen bis 2029, der Zeitplan bis zum Beschluss und die Quellen."
>
  <header class="page-head">
    <div class="container">
      <p class="label">Hintergrund</p>
      <h1>Worum es geht</h1>
      <p class="lead">
        Die Stadt Erlangen muss bis 2029 weitere 29 Millionen Euro einsparen. Hier stehen die offiziellen Zahlen, der
        Zeitplan – und wie die Summe der Projekte auf dieser Plattform zustande kommt.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="zahlen-titel">
    <div class="container">
      <div class="section__head">
        <h2 id="zahlen-titel">Die offiziellen Zahlen</h2>
      </div>
      <BudgetFacts />
      <div class="prose bg__details">
        <ul>{budgetDetails.map((line) => <li>{line}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="zeitplan-titel">
    <div class="container">
      <div class="section__head">
        <h2 id="zeitplan-titel">Der Zeitplan</h2>
        <p>
          Noch ist nichts beschlossen. Die Einsparvorschläge werden in den Fachausschüssen und im Haushalts-HFPA einzeln
          abgestimmt.
        </p>
      </div>
      <Timeline />
    </div>
  </section>

  <section class="section" aria-labelledby="summe-titel">
    <div class="container prose">
      <h2 id="summe-titel">So entsteht die Summe der Projekte</h2>
      <p>
        Die Summe der Projekte auf dieser Plattform ist keine Hochrechnung und keine Schätzung. Sie addiert die Kürzungen, die für das
        Jahr 2027 geplant sind, bei allen Projekten auf dieser Plattform. Eine Einrichtung kann mehrere betroffene
        Projekte eintragen; jedes zählt einzeln. Kürzungen in späteren Jahren stehen bei den Projekten, fließen aber
        nicht in die Summe ein – ebenso wenig Kürzungen ohne Geldbetrag (z. B. wegfallende Mietzuschüsse).
      </p>
      {
        projectCount > 0 && (
          <p>
            Aktuell: <strong class="nobreak">{formatEuro(totalAmount)}</strong> bei {withAmount.length} von{' '}
            {count(projectCount, 'Projekt', 'Projekten')} aus {count(organisationCount, 'Einrichtung', 'Einrichtungen')}.
            Davon {verified} vom Bündnis geprüft (mit Quelle), die übrigen als „Angabe der Einrichtung“ gekennzeichnet.
          </p>
        )
      }
      <p>
        Jeder Eintrag wird vom Bündnis geprüft, bevor er erscheint. Wo ein Betrag in den Unterlagen der Stadt belegt
        ist, nennen wir die Quelle direkt am Betrag.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="quellen-titel">
    <div class="container prose">
      <h2 id="quellen-titel">Quellen</h2>
      <ul>
        <li>
          {settings.sourceUrl ? <ExternalLink href={settings.sourceUrl}>{settings.sourceTitle}</ExternalLink> : settings.sourceTitle}
        </li>
      </ul>
    </div>
  </section>
</Page>

<style>
  .bg__details {
    margin-top: var(--space-6);
  }
</style>
