---
// Internal tool: social media posts and stories in the style of the website.
// Protected on the server with Basic Auth (see scripts/deploy-package.ts); never on GitHub Pages.
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/paths.ts';
import { getOrganisation, projects } from '../../data/index.ts';
import { areas } from '../../data/areas.ts';
import { SAVINGS_REFERATE, savingsList } from '../../data/savings-list.ts';
import { AMOUNT_YEAR } from '../../data/budget.ts';
import '../../styles/social.css';

/** Largest WebP rendition of an image, for 1080 px wide exports. */
const largest = (srcset: string) =>
  srcset
    .split(',')
    .map((part) => part.trim().split(/\s+/))
    .sort((a, b) => parseInt(b[1] ?? '0') - parseInt(a[1] ?? '0'))[0]?.[0];

const data = {
  amountYear: AMOUNT_YEAR,
  logo: url('/brand/logo.png'),
  areas: areas.map((a) => ({ slug: a.slug, label: a.label })),
  projects: [...projects]
    .sort((a, b) => a.orgName.localeCompare(b.orgName, 'de') || a.name.localeCompare(b.name, 'de'))
    .map((p) => {
      const webp = p.image?.sources.find((s) => s.type === 'image/webp')?.srcset;
      return {
        id: p.id,
        org: getOrganisation(p.orgSlug)?.name ?? p.orgName,
        name: p.name,
        area: p.area,
        amount: p.amount,
        nonMonetary: p.nonMonetary,
        quote: p.quote,
        consequences: p.consequences,
        image: p.image ? url(webp ? largest(webp)! : p.image.src) : null,
        credit: p.image?.credit ? `${p.image.kind === 'logo' ? 'Bild' : 'Foto'}: ${p.image.credit}` : '',
        logo: p.image?.kind === 'logo',
      };
    }),
  referate: SAVINGS_REFERATE,
  savings: savingsList.map((m) => ({
    referat: m.referat,
    amt: m.amt,
    nr: m.nr,
    title: m.title,
    amounts: m.amounts,
    note: m.note,
  })),
};
// "<" escaped so the JSON can never close the script element.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<Base title="Social-Media-Vorlagen (intern)" noindex>
  <div class="social" data-social>
    <header class="social__bar">
      <img src={url('/brand/logo.png')} width="1200" height="1056" alt="" />
      <p><strong>Social-Media-Vorlagen</strong> <span>intern · nur für das Bündnis</span></p>
    </header>

    <div class="social__layout">
      <form class="social__controls" data-controls onsubmit="return false">
        <fieldset class="step">
          <legend><span class="step__no">1</span> Format</legend>
          <div class="seg" role="radiogroup">
            <label><input type="radio" name="format" value="post" checked /> <span>Post <small>4:5</small></span></label>
            <label><input type="radio" name="format" value="story" /> <span>Story <small>9:16</small></span></label>
          </div>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step__no">2</span> Vorlage</legend>
          <div class="cards" data-templates></div>
        </fieldset>

        <fieldset class="step" data-source-step>
          <legend><span class="step__no">3</span> Inhalt</legend>
          <div data-source></div>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step__no">4</span> Texte anpassen</legend>
          <div class="fields" data-fields></div>
          <button type="button" class="linkbtn" data-reset>Texte zurücksetzen</button>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step__no">5</span> Speichern</legend>
          <p class="small">Bilder werden heruntergeladen – mehrere auf einmal als ZIP, das den Projektordner enthält.</p>
          <div class="actions">
            <button type="button" class="btn" data-save>Bild speichern</button>
            <button type="button" class="btn btn--outline" data-save-all>Alle Vorlagen für dieses Projekt</button>
          </div>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </fieldset>
      </form>

      <section class="social__preview" aria-label="Vorschau">
        <div class="preview__head">
          <p class="label" data-size></p>
          <label class="small" data-safe-toggle hidden><input type="checkbox" data-safe /> Von Instagram verdeckte Bereiche zeigen</label>
        </div>
        <div class="preview__frame" data-frame>
          <div class="preview__art" data-preview></div>
          <div class="preview__safe" aria-hidden="true"></div>
        </div>
      </section>
    </div>

    <!-- Exports are rendered here at full size, out of sight. -->
    <div class="social__stage" aria-hidden="true" data-stage></div>
  </div>

  <script type="application/json" id="social-data" set:html={json} />
</Base>

<script>
  import { start } from '../../scripts/social/app.ts';
  start();
</script>

<style>
  .social {
    min-height: 100vh;
  }

  .social__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--gutter);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .social__bar img {
    width: 3.5rem;
    height: auto;
    padding: 0.35rem;
    background: var(--color-signal);
  }

  .social__bar span {
    color: var(--color-signal);
    font-weight: 700;
    margin-left: var(--space-2);
  }

  .social__layout {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5) var(--gutter) var(--space-8);
  }

  @media (min-width: 60em) {
    .social__layout {
      grid-template-columns: minmax(20rem, 28rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .social__controls {
    display: grid;
    gap: var(--space-5);
  }

  .social__controls :global(.step) {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0 0 var(--space-5);
    border: 0;
    border-bottom: var(--line) solid var(--color-ink);
  }

  .social__controls :global(legend) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--fs-h3);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
  }

  .step__no {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--color-ink);
    color: var(--color-signal);
    font-size: 1rem;
    font-stretch: 100%;
  }

  /* Segmented format switch and template cards share the "checked = signal" look. */
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: var(--line-strong) solid var(--color-ink);
  }

  .seg label,
  .social__controls :global(.card) {
    position: relative;
    cursor: pointer;
  }

  .seg input,
  .social__controls :global(.card input) {
    position: absolute;
    opacity: 0;
  }

  .seg span {
    display: block;
    padding: var(--space-3);
    text-align: center;
    font-weight: 800;
  }

  .seg label + label span {
    border-left: var(--line-strong) solid var(--color-ink);
  }

  .seg input:checked + span,
  .social__controls :global(.card input:checked + span) {
    background: var(--color-signal);
  }

  .seg input:focus-visible + span,
  .social__controls :global(.card input:focus-visible + span) {
    outline: var(--focus-width) solid var(--color-ink);
    outline-offset: 2px;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .social__controls :global(.card span) {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: var(--space-3);
    border: var(--line) solid var(--color-ink);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .social__controls :global(.card b) {
    font-size: 1.0625rem;
  }

  .social__controls :global(.field) {
    display: grid;
    gap: var(--space-1);
  }

  .social__controls :global(.field > span) {
    font-weight: 800;
    font-size: var(--fs-small);
  }

  .social__controls :global(input[type='text']),
  .social__controls :global(textarea),
  .social__controls :global(select) {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: var(--line) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-white, #fff);
    font: inherit;
    font-size: 1rem;
  }

  .social__controls :global(textarea) {
    min-height: 5.5rem;
    resize: vertical;
  }

  .fields {
    display: grid;
    gap: var(--space-4);
  }

  .social__controls :global(.imgfield) {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-3);
    align-items: center;
  }

  .social__controls :global(.imgfield img) {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border: var(--line) solid var(--color-ink);
    background: #fff;
  }

  .social__controls :global(.hint) {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .social__controls :global(.linkbtn) {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: var(--line);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .status {
    min-height: 1.5em;
    font-weight: 700;
  }

  .social__preview {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 60em) {
    .social__preview {
      position: sticky;
      top: var(--space-4);
    }
  }

  .preview__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    align-items: baseline;
  }

  .preview__frame {
    position: relative;
    justify-self: start;
    overflow: hidden;
    border: var(--line-strong) solid var(--color-ink);
    box-shadow: calc(var(--offset) * 2) calc(var(--offset) * 2) 0 var(--color-ink);
  }

  .preview__art {
    transform-origin: 0 0;
  }

  .preview__safe {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      rgb(0 0 0 / 0.45) 0 var(--safe),
      transparent var(--safe) calc(100% - var(--safe)),
      rgb(0 0 0 / 0.45) calc(100% - var(--safe))
    );
  }

  .preview__frame.show-safe .preview__safe {
    display: block;
  }

  .social__stage {
    position: fixed;
    left: -20000px;
    top: 0;
    pointer-events: none;
  }
</style>
