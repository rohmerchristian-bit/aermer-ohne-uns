---
import { srcsetUrl, url } from '../lib/paths.ts';
import type { Institution } from '../data/types';
import { getArea } from '../data/areas';
import { formatCut, initials, truncate } from '../lib/format';
import { amountSourceLabel } from '../lib/amount-label';
import IconFlip from './icons/IconFlip.astro';
import IconArrow from './icons/IconArrow.astro';
import IconExternal from './icons/IconExternal.astro';

interface Props {
  institution: Institution;
  /** Heading level of the institution name, so the tile fits the page outline. */
  headingLevel?: 2 | 3 | 4;
  /** Static demo state for the styleguide: render the back side. */
  flipped?: boolean;
  /** Keeps element ids unique when the same institution appears twice on a page. */
  idSuffix?: string;
}

const { institution: inst, headingLevel = 3, flipped = false, idSuffix = '' } = Astro.props;
const area = getArea(inst.area);
const id = `tile-${inst.slug}${idSuffix}`;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

const CONSEQUENCES_MAX = 280;
const QUOTE_MAX = 110;
// Tile width per breakpoint (see .tile-grid in src/styles/layout.css).
const IMAGE_SIZES = '(min-width: 96em) 22rem, (min-width: 64em) 30vw, (min-width: 40em) 46vw, 92vw';

const sourceLabel = amountSourceLabel(inst);

const externalUrl = inst.infoLink ?? inst.website;
const externalLabel = inst.infoLink ? 'Stellungnahme' : 'Website';
---

<article
  class:list={['tile', { 'is-flipped': flipped }]}
  data-area={area.slug}
  data-tile
  aria-labelledby={`${id}-name`}
>
  <div class="tile__card">
    <div class="tile__face tile__front" id={`${id}-front`} data-tile-front>
      <p class="tile__area label">{area.label}</p>
      <Heading class="tile__name" id={`${id}-name`}>{inst.name}</Heading>
      {inst.project && <p class="tile__project">{inst.project}</p>}

      <div class="tile__money">
        {
          inst.amount !== null ? (
            <p class="tile__amount">
              <span class:list={['tile__amount-value', { 'tile__amount-value--long': inst.amount >= 1_000_000 }]}>
                {formatCut(inst.amount)}
              </span>
              <span class="tile__amount-unit">/&nbsp;Jahr</span>
            </p>
          ) : (
            <p class="tile__amount tile__amount--pending">Betrag folgt</p>
          )
        }
        {sourceLabel && <p class="tile__source">{sourceLabel}</p>}
      </div>

      <button
        type="button"
        class="tile__flip"
        aria-expanded={flipped ? 'true' : 'false'}
        aria-controls={`${id}-back`}
        data-tile-open
      >
        <span class="tile__hint label">Umdrehen <IconFlip /></span>
        <span class="visually-hidden">: Folgen, Zitat und Links zu {inst.name} anzeigen</span>
      </button>
    </div>

    <div class="tile__face tile__back" id={`${id}-back`} data-tile-back>
      <figure class="tile__media">
        {
          inst.image ? (
            <picture class:list={['tile__picture', `tile__picture--${inst.image.kind}`]}>
              {inst.image.sources.map((source) => (
                <source type={source.type} srcset={srcsetUrl(source.srcset)} sizes={IMAGE_SIZES} />
              ))}
              <img
                src={url(inst.image.src)}
                width={inst.image.width}
                height={inst.image.height}
                alt={inst.image.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : (
            <div class="tile__placeholder" aria-hidden="true">
              {initials(inst.name)}
            </div>
          )
        }
        {
          inst.image?.credit && (
            <figcaption class="tile__credit">
              {inst.image.kind === 'logo' ? 'Bild' : 'Foto'}: {inst.image.credit}
            </figcaption>
          )
        }
      </figure>

      <div class="tile__back-body">
        {
          inst.quote && (
            <blockquote class="tile__quote">
              <p>„{truncate(inst.quote, QUOTE_MAX)}“</p>
            </blockquote>
          )
        }
        {inst.consequences && <p class="tile__consequences">{truncate(inst.consequences, CONSEQUENCES_MAX)}</p>}
      </div>

      <ul class="tile__links" role="list">
        <li>
          <a href={url(`/einrichtungen/${inst.slug}/`)}>
            Mehr erfahren <IconArrow />
            <span class="visually-hidden"> über {inst.name}</span>
          </a>
        </li>
        {
          externalUrl && (
            <li>
              <a href={externalUrl} target="_blank" rel="noopener">
                {externalLabel} <IconExternal />
                <span class="visually-hidden"> von {inst.name} (externer Link, öffnet in neuem Tab)</span>
              </a>
            </li>
          )
        }
      </ul>

      <button type="button" class="tile__close label" aria-controls={`${id}-front`} data-tile-close>
        Zurück<span class="visually-hidden"> zur Vorderseite von {inst.name}</span>
      </button>
    </div>
  </div>
</article>

<script>
  import { initTiles } from '../scripts/tile-flip';
  initTiles();
</script>

<style>
  .tile {
    --tile-pad: clamp(1.125rem, 6cqi, 1.75rem);
    container-type: inline-size;
    position: relative;
    height: var(--tile-height);
    perspective: 1800px;
  }

  .tile__card {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--duration-flip) var(--ease-flip);
  }

  .tile.is-flipped .tile__card {
    transform: rotateY(180deg);
  }

  .tile__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* The hidden face is removed from the accessibility tree and tab order via visibility,
     switched exactly when the card passes its edge. */
  .tile__front {
    visibility: visible;
    transition: visibility 0s;
  }

  .tile.is-flipped .tile__front {
    visibility: hidden;
    transition: visibility 0s linear var(--duration-flip);
  }

  .tile__back {
    transform: rotateY(180deg);
    visibility: hidden;
    transition: visibility 0s linear var(--duration-flip);
  }

  .tile.is-flipped .tile__back {
    visibility: visible;
    transition: visibility 0s;
  }

  /* ---------- Front ---------- */

  .tile__front {
    padding: var(--tile-pad);
    gap: var(--space-3);
    background: var(--area-bg);
    color: var(--area-fg);
    --focus-color: var(--color-ink);
  }

  .tile__name {
    font-size: clamp(1.625rem, 9cqi, 2.5rem);
    font-weight: 900;
    line-height: 0.98;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .tile__project {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .tile__money {
    margin-top: auto;
    padding-bottom: 2.75rem;
  }

  .tile__amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .tile__amount-value {
    font-size: clamp(2.75rem, 17cqi, 4.75rem);
    white-space: nowrap;
  }

  .tile__amount-value--long {
    font-size: clamp(2.25rem, 13cqi, 3.75rem);
  }

  .tile__amount-unit {
    font-size: 1.375rem;
    font-weight: 800;
  }

  .tile__amount--pending {
    font-size: clamp(2rem, 12cqi, 3rem);
  }

  .tile__source {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The flip button covers the whole front, so a click or tap anywhere turns the card. */
  .tile__flip {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--tile-pad);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .tile__flip:focus-visible {
    outline-offset: -8px;
  }

  .tile__hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: 2px;
    border-bottom: var(--line) solid currentColor;
  }

  .tile__hint .icon {
    width: 1.25em;
    height: 1.25em;
    transition: transform var(--duration-fast) ease-out;
  }

  .tile__flip:hover .tile__hint .icon {
    transform: rotate(90deg);
  }

  /* ---------- Back ---------- */

  .tile__back {
    background: var(--color-paper);
    color: var(--color-ink);
    border: var(--line-strong) solid var(--color-ink);
  }

  .tile__media {
    position: relative;
    flex: none;
    height: 32%;
    background: var(--area-bg);
  }

  .tile__picture,
  .tile__picture img {
    width: 100%;
    height: 100%;
  }

  .tile__picture--photo img {
    object-fit: cover;
  }

  /* Logos are never cropped: shown whole on white. */
  .tile__picture--logo {
    padding: var(--space-4);
    background: var(--color-white);
  }

  .tile__picture--logo img {
    object-fit: contain;
  }

  .tile__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--area-fg);
    font-size: clamp(3.5rem, 26cqi, 7rem);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .tile__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 100%;
    padding: 0.2rem 0.5rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile__back-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
    padding: var(--space-4) var(--tile-pad) 0;
    overflow: hidden;
  }

  .tile__quote {
    font-size: 1.25rem;
    font-weight: 800;
    font-stretch: var(--stretch-semi);
    line-height: 1.15;
  }

  .tile__quote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .tile__quote,
  .tile__consequences {
    flex: none;
  }

  .tile__consequences {
    font-size: var(--fs-small);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .tile__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: auto 0 0;
    padding: var(--space-4) var(--tile-pad);
    padding-right: 6rem;
    list-style: none;
    font-weight: 800;
    font-stretch: var(--stretch-semi);
  }

  .tile__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tile__close {
    position: absolute;
    right: 0;
    bottom: 0;
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    border: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    cursor: pointer;
    --focus-color: var(--color-ink);
  }

  /* Reduced motion: plain cross-fade instead of the 3D turn. */
  @media (prefers-reduced-motion: reduce) {
    .tile__card,
    .tile.is-flipped .tile__card {
      transform: none;
      transition: none;
    }

    .tile__back {
      transform: none;
    }

    /* Visible face: fades in, becomes visible at once. */
    .tile .tile__front,
    .tile.is-flipped .tile__back {
      opacity: 1;
      transition:
        opacity 0.2s linear,
        visibility 0s;
    }

    /* Hidden face: fades out, leaves the accessibility tree after the fade. */
    .tile .tile__back,
    .tile.is-flipped .tile__front {
      opacity: 0;
      transition:
        opacity 0.2s linear,
        visibility 0s linear 0.2s;
    }

    .tile__hint .icon {
      transition: none;
    }
  }
</style>
