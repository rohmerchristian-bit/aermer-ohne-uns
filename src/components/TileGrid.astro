---
import Tile from './Tile.astro';
import type { Project } from '../data/types.ts';

// List of project tiles. Each item carries data attributes for the client-side filter.
interface Props {
  projects: Project[];
  headingLevel?: 2 | 3 | 4;
  id?: string;
  /** Marks the list for src/scripts/filter.ts. */
  filterable?: boolean;
}
const { projects, headingLevel = 3, id, filterable = false } = Astro.props;
const searchText = (p: Project) =>
  [p.name, p.orgName, p.cutDescription, p.consequences, p.nonMonetary].filter(Boolean).join(' ').toLocaleLowerCase('de');
---

<ul class="tile-grid" role="list" id={id} data-filter-list={filterable ? '' : undefined}>
  {
    projects.map((p) => (
      <li
        data-area={p.area}
        data-amount={p.amount ?? ''}
        data-name={p.name}
        data-org={p.orgSlug}
        data-featured={p.featured ? 'true' : undefined}
        data-search={searchText(p)}
      >
        <Tile project={p} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>
