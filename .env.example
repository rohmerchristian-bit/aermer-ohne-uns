# Copy this file to .env and fill in the values. Never commit .env.

# Public base URL of the website (used for sitemap, Open Graph, share links)
SITE_URL=https://aermer-ohne-uns.example

# "sample" = example data from data/sample/, "remote" = published Google Sheet CSVs
DATA_SOURCE=sample

# Published CSV URLs from Google Sheets ("Datei -> Freigeben -> Im Web veröffentlichen")
SHEET_PUBLIC_CSV_URL=
SHEET_SETTINGS_CSV_URL=

# ---- Deployment (nur als GitHub-Secrets bzw. lokal in .env.deploy – nie committen) ----
# SITE_URL=https://aermerohneuns.de
# COMING_SOON=1            # 1 = nur „startet in Kürze“-Seite online
# FTP_HOST=wwwNNN.your-server.de
# FTP_USER=
# FTP_PASSWORD=
# FTP_DIR=public_html
