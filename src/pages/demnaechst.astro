---
import { url } from '../lib/paths.ts';
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import BankTransfer from '../components/BankTransfer.astro';
import IconExternal from '../components/icons/IconExternal.astro';
import { settings } from '../data/index.ts';
import { getDonationStatus } from '../data/donations.ts';
import { instagramHandle } from '../lib/format.ts';

// "Coming soon" page. With COMING_SOON=1 the deploy workflow publishes only this page
// (as / and as the 404 page). No navigation, so it never links to pages that are not online yet –
// that is why the donation details are shown here in full instead of linking to /spenden/.
const donation = getDonationStatus(settings);
---

<Base
  title="Ärmer ohne uns"
  description="Die Plattform des Bündnisses #ÄrmerOhneUns startet in Kürze: welche Erlanger Einrichtungen von den Kürzungen im Haushalt 2027 betroffen sind."
  noindex
>
  <section class="soon">
    <div class="container soon__inner">
      <h1 class="soon__logo">
        <img src={url('/brand/logo.webp')} width="1200" height="1056" alt="Ärmer ohne uns" fetchpriority="high" />
      </h1>

      <div class="soon__text">
        <p class="label">Erlangen · Haushalt 2027</p>
        <p class="soon__title">Die Plattform startet in Kürze.</p>
        <p class="lead">
          Hier zeigen Kultur-, Bildungs- und Sozialeinrichtungen bald, was durch die Kürzungen im Haushalt 2027
          verloren geht.
        </p>

        {settings.notice && <p class="soon__notice">{settings.notice}</p>}

        <ul class="soon__links" role="list">
          <li>
            <a href="#spenden">Jetzt spenden: WirWunder oder Überweisung</a>
          </li>
          {
            settings.formUrl && (
              <li>
                <ExternalLink href={settings.formUrl}>Eure Einrichtung ist betroffen? Jetzt eintragen</ExternalLink>
              </li>
            )
          }
          {
            settings.instagramUrl && (
              <li>
                <ExternalLink href={settings.instagramUrl}>
                  Folgt uns auf Instagram{instagramHandle(settings.instagramUrl) && `: ${instagramHandle(settings.instagramUrl)}`}
                </ExternalLink>
              </li>
            )
          }
          {
            settings.contactEmail && (
              <li>
                <a href={`mailto:${settings.contactEmail}`}>Kontakt: {settings.contactEmail}</a>
              </li>
            )
          }
        </ul>

        <p class="small soon__legal">
          <a href={url('/impressum/')}>Impressum</a> · <a href={url('/datenschutz/')}>Datenschutz</a>
        </p>

        <p class="small soon__note">
          Eine Initiative des Bündnisses <span class="nobreak">#ÄrmerOhneUns</span>, verantwortlich: E-Werk
          Kulturzentrum GmbH, Erlangen.
        </p>
      </div>
    </div>
  </section>

  <section class="soon-donate" id="spenden" aria-labelledby="spenden-titel">
    <div class="container soon-donate__inner">
      <div class="soon-donate__text">
        <p class="label">Jetzt schon spenden</p>
        <h2 id="spenden-titel" class="soon-donate__title">Was wegfällt, fangen wir gemeinsam auf.</h2>
        <p>
          Damit Angebote in Sozialarbeit, für Kinder und Familien, in Kultur und Sport erhalten bleiben, hat das Bündnis
          ÄrmerOhneUns eine zentrale Spendenkooperation mit der gemeinnützigen Erlanger Bürgerstiftung geschlossen. Sie
          verwaltet die Spenden auf einem eigenen Konto; ein Kuratorium entscheidet, welche Vereine und Projekte sie
          erhalten.
        </p>
        <p>
          Sie können im Zuge Ihrer Spende über die Funktion „Kommentar“ angeben, für welche Organisation Ihre Spende
          bestimmt ist.
        </p>
        {
          donation.url && (
            <div class="soon-donate__actions">
              <a class="btn" href={donation.url} target="_blank" rel="noopener">
                Bei WirWunder spenden <IconExternal />
                <span class="visually-hidden"> (externer Link, öffnet in neuem Tab)</span>
              </a>
              <p class="small">
                WirWunder ist die Spendenplattform der Sparkassen-Finanzgruppe in Kooperation mit betterplace.org; die
                Spendenbescheinigung erhalten Sie von betterplace.org.
              </p>
            </div>
          )
        }
      </div>
      <div class="soon-donate__transfer">
        <h3 class="soon-donate__subtitle">Per Überweisung</h3>
        <BankTransfer />
      </div>
    </div>
  </section>
</Base>

<style>
  .soon {
    min-height: 100vh;
    display: grid;
    align-items: center;
    padding-block: var(--space-7);
  }

  .soon__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 64em) {
    .soon__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .soon__logo {
    display: grid;
    place-items: center;
    max-width: 34rem;
    aspect-ratio: 1;
    padding: clamp(1.25rem, 5vw, 3rem);
    background: var(--color-signal);
    border: var(--line-strong) solid var(--color-ink);
  }

  .soon__logo img {
    width: 100%;
    height: auto;
  }

  .soon__text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .soon__title {
    font-size: var(--fs-h1);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 14ch;
  }

  .soon__notice {
    padding: var(--space-3) var(--space-4);
    background: var(--color-ink);
    color: var(--color-signal);
    font-weight: 800;
  }

  .soon__links {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 800;
  }

  .soon__legal {
    font-weight: 700;
  }

  .soon__note {
    color: var(--color-muted);
  }

  .soon-donate {
    background: var(--color-signal);
    color: var(--color-signal-text);
    border-top: var(--line-strong) solid var(--color-ink);
  }

  .soon-donate__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  @media (min-width: 64em) {
    .soon-donate__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }

  .soon-donate__text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .soon-donate__title {
    font-size: var(--fs-h2);
    font-weight: 900;
    line-height: var(--lh-tight);
  }

  .soon-donate__actions {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .soon-donate__transfer {
    display: grid;
    gap: var(--space-3);
  }

  .soon-donate__subtitle {
    font-size: var(--fs-h3);
    font-weight: 900;
  }
</style>
