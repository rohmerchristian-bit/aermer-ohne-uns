---
import Page from '../layouts/Page.astro';
import BudgetFacts from '../components/BudgetFacts.astro';
import Timeline from '../components/Timeline.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { settings } from '../data/index.ts';
import { pageCardAlt, shareImagePath } from '../data/share.ts';
---

<Page
  title="Worum es geht"
  ogImage={shareImagePath('hintergrund')}
  ogImageAlt={pageCardAlt('hintergrund')}
  description="Die offiziellen Zahlen zur Haushaltskonsolidierung der Stadt Erlangen bis 2029, der Zeitplan bis zum Beschluss und die Quellen."
>
  <header class="page-head">
    <div class="container">
      <p class="label">Hintergrund</p>
      <h1>Worum es geht</h1>
      <p class="lead">
        Die Stadt Erlangen muss bis 2029 weitere 29 Millionen Euro einsparen. Hier stehen die offiziellen Zahlen und der
        Zeitplan.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="zahlen-titel">
    <div class="container">
      <div class="section__head">
        <h2 id="zahlen-titel">Die offiziellen Zahlen</h2>
      </div>
      <BudgetFacts />
    </div>
  </section>

  <section class="section" aria-labelledby="zeitplan-titel">
    <div class="container">
      <div class="section__head">
        <h2 id="zeitplan-titel">Der Zeitplan</h2>
        <p>
          Noch ist nichts beschlossen. Die Einsparvorschläge werden in den Fachausschüssen und im Haushalts-HFPA einzeln
          abgestimmt.
        </p>
      </div>
      <Timeline />
    </div>
  </section>

  <section class="section" aria-labelledby="quellen-titel">
    <div class="container prose">
      <h2 id="quellen-titel">Quellen</h2>
      <ul>
        <li>
          {settings.sourceUrl ? <ExternalLink href={settings.sourceUrl}>{settings.sourceTitle}</ExternalLink> : settings.sourceTitle}
        </li>
        <li>
          Stadt Erlangen:{' '}
          <ExternalLink href="https://erlangen.de/aktuelles/haushalt-2027-umfassende-sparberatungen-beginnen">
            Haushalt 2027: Umfassende Sparberatungen beginnen
          </ExternalLink>
        </li>
      </ul>
    </div>
  </section>
</Page>

