---
import { srcsetUrl, url } from '../../lib/paths.ts';
import Page from '../../layouts/Page.astro';
import TileGrid from '../../components/TileGrid.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import DonationBlock from '../../components/DonationBlock.astro';
import IconArrow from '../../components/icons/IconArrow.astro';
import { areas, getArea } from '../../data/areas.ts';
import { count, organisations, projects, projectsOf, settings, sortedForGrid } from '../../data/index.ts';
import type { InstitutionImage, Organisation } from '../../data/types.ts';
import { amountSourceLabel, percentLabel } from '../../lib/amount-label.ts';
import { formatCut, initials, truncate } from '../../lib/format.ts';
import { organisationShareImagePath } from '../../data/share.ts';
import { organisationCardAlt } from '../../data/organisation-card.ts';

// One page per organisation, with a section for each of its affected projects.
export function getStaticPaths() {
  return organisations.map((organisation) => ({ params: { slug: organisation.slug }, props: { organisation } }));
}

interface Props {
  organisation: Organisation;
}

const { organisation: org } = Astro.props;
const own = projectsOf(org.slug);
const total = own.reduce((sum, p) => sum + (p.amount ?? 0), 0);
const mainArea = getArea(own[0]!.area);
const orgAreas = areas.filter((a) => own.some((p) => p.area === a.slug));
const related = sortedForGrid(
  projects.filter((p) => p.orgSlug !== org.slug && orgAreas.some((a) => a.slug === p.area)),
).slice(0, 3);

const paragraphs = (text: string | null) => (text ? text.split(/\n{2,}/).map((p) => p.split('\n')) : []);
const socialLinks = org.links.filter((l) => l !== org.website);
// Contact for questions and offers of help; every form entry has its own, so collect the distinct ones.
const unique = (values: (string | null)[]) => [...new Set(values.filter((v): v is string => Boolean(v)))];
const emails = unique(own.map((p) => p.contactEmail));
const phones = unique(own.map((p) => p.contactPhone));
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
const linkLabel = (link: string) => new URL(link).hostname.replace(/^www\./, '');
const pageUrl = new URL(url(`/einrichtungen/${org.slug}/`), Astro.site).toString();

const description = truncate(
  [
    `${count(own.length, 'betroffenes Projekt', 'betroffene Projekte')}`,
    total > 0 ? `${formatCut(total)} im Jahr 2027.` : null,
    own.map((p) => p.name).join(', '),
  ]
    .filter(Boolean)
    .join(' · '),
  160,
);

const imageCaption = (img: InstitutionImage) => `${img.kind === 'logo' ? 'Bild' : 'Foto'}: ${img.credit}`;
---

<Page
  title={org.name}
  description={description}
  ogType="article"
  ogImage={organisationShareImagePath(org.slug)}
  ogImageAlt={organisationCardAlt(org.slug)}
>
  <article class="detail" aria-labelledby="detail-titel">
    <header class="detail__head" data-area={mainArea.slug}>
      <div class="container detail__head-inner">
        <p class="detail__back">
          <a href={url('/einrichtungen/')}>Alle Projekte</a>
        </p>
        <p class="label">{orgAreas.map((a) => a.label).join(' · ')}</p>
        <h1 id="detail-titel" class="detail__name">{org.name}</h1>
        <p class="detail__summary">
          {count(own.length, 'betroffenes Projekt', 'betroffene Projekte')}
          {total > 0 && <>, zusammen <span class="nobreak">{formatCut(total)}</span> im Jahr 2027</>}
        </p>
        {
          own.length > 1 && (
            <nav aria-label="Projekte dieser Einrichtung">
              <ul class="detail__toc" role="list">
                {own.map((p) => (
                  <li>
                    <a href={`#${p.anchor}`}>{p.name}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <div class="container detail__about">
      <figure class:list={['detail__logo', org.logo && `detail__logo--${org.logo.kind}`]}>
        {
          org.logo ? (
            <picture>
              {org.logo.sources.map((source) => (
                <source type={source.type} srcset={srcsetUrl(source.srcset)} sizes="(min-width: 64em) 24rem, 60vw" />
              ))}
              <img
                src={url(org.logo.src)}
                width={org.logo.width}
                height={org.logo.height}
                alt={org.logo.alt}
                decoding="async"
              />
            </picture>
          ) : (
            <div class="detail__placeholder" data-area={mainArea.slug} aria-hidden="true">
              {initials(org.name)}
            </div>
          )
        }
        {org.logo?.credit && <figcaption class="detail__credit small">{imageCaption(org.logo)}</figcaption>}
      </figure>

      <div class="detail__text">
        {
          org.description && (
            <section class="detail__section" aria-labelledby="abschnitt-arbeit">
              <h2 id="abschnitt-arbeit" class="h3">Was wir tun</h2>
              {paragraphs(org.description).map((lines) => (
                <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
              ))}
            </section>
          )
        }
        {
          org.reach && (
            <section class="detail__section" aria-labelledby="abschnitt-reichweite">
              <h2 id="abschnitt-reichweite" class="h3">Wen wir erreichen</h2>
              {paragraphs(org.reach).map((lines) => (
                <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
              ))}
            </section>
          )
        }
        <section class="detail__section" id="kontakt" aria-labelledby="abschnitt-kontakt">
          <h2 id="abschnitt-kontakt" class="h3">Kontakt und Links</h2>
          {org.address && <p>{org.address}</p>}
          <ul class="detail__links" role="list">
            {
              emails.map((email) => (
                <li>
                  <a href={`mailto:${email}`}>
                    <span class="visually-hidden">E-Mail an {org.name}: </span>
                    {email}
                  </a>
                </li>
              ))
            }
            {
              phones.map((phone) => (
                <li>
                  <a href={telHref(phone)}>
                    <span class="visually-hidden">{org.name} anrufen: </span>
                    Tel. {phone}
                  </a>
                </li>
              ))
            }
            {
              org.website && (
                <li>
                  <ExternalLink href={org.website} context={`von ${org.name}`}>
                    Website ({linkLabel(org.website)})
                  </ExternalLink>
                </li>
              )
            }
            {
              socialLinks.map((link) => (
                <li>
                  <ExternalLink href={link} context={`von ${org.name}`}>
                    {linkLabel(link)}
                  </ExternalLink>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    {
      own.map((p) => {
        const area = getArea(p.area);
        const notes = [percentLabel(p.amountPercent), amountSourceLabel(p)].filter(Boolean).join(' · ');
        return (
          <section class="project" id={p.anchor} data-area={area.slug} aria-labelledby={`${p.anchor}-titel`}>
            <div class="container project__inner">
              <header class="project__head">
                <p class="label project__area">
                  <span class="project__swatch" aria-hidden="true" />
                  {area.label}
                </p>
                <h2 id={`${p.anchor}-titel`} class="project__name">
                  {p.name}
                </h2>
                {p.amount !== null ? (
                  <p class="project__amount">
                    <span class="nobreak">{formatCut(p.amount)}</span> <span class="project__per">im Jahr 2027</span>
                  </p>
                ) : p.nonMonetary ? (
                  <p class="project__amount project__amount--text">{p.nonMonetary}</p>
                ) : (
                  <p class="project__amount project__amount--text">Betrag folgt</p>
                )}
                {p.amountLater && <p class="project__later">Danach: {p.amountLater}</p>}
                {notes && <p class="project__source small">{notes}</p>}
              </header>

              <div class="project__body">
                {p.ownImage && p.image && (
                  <figure class={`project__media project__media--${p.image.kind}`}>
                    <picture>
                      {p.image.sources.map((source) => (
                        <source type={source.type} srcset={srcsetUrl(source.srcset)} sizes="(min-width: 64em) 40vw, 92vw" />
                      ))}
                      <img
                        src={url(p.image.src)}
                        width={p.image.width}
                        height={p.image.height}
                        alt={p.image.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                    {p.image.credit && <figcaption class="detail__credit small">{imageCaption(p.image)}</figcaption>}
                  </figure>
                )}

                {p.quote && (
                  <blockquote class="detail__quote">
                    <p>„{p.quote}“</p>
                  </blockquote>
                )}

                {p.consequences && (
                  <div class="detail__section">
                    <h3 class="h3">Was die Kürzung bedeutet</h3>
                    {paragraphs(p.consequences).map((lines) => (
                      <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
                    ))}
                  </div>
                )}
                {p.cutDescription && (
                  <div class="detail__section">
                    <h3 class="h3">Was gekürzt werden soll</h3>
                    {paragraphs(p.cutDescription).map((lines) => (
                      <p>{lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
                    ))}
                  </div>
                )}
                {p.infoLink && (
                  <p class="detail__links">
                    <ExternalLink href={p.infoLink} context={`zu ${p.name}`}>
                      Stellungnahme / weitere Informationen
                    </ExternalLink>
                  </p>
                )}
                {/* With several projects the tile link lands here, below the organisation's contact
                    details – so each project repeats its own contact and links back up. */}
                {own.length > 1 && (
                  <div class="project__contact">
                    <h3 class="label">Kontakt</h3>
                    {(p.contactEmail || p.contactPhone) && (
                      <ul class="detail__links" role="list">
                        {p.contactEmail && (
                          <li>
                            <a href={`mailto:${p.contactEmail}`}>{p.contactEmail}</a>
                          </li>
                        )}
                        {p.contactPhone && (
                          <li>
                            <a href={telHref(p.contactPhone)}>Tel. {p.contactPhone}</a>
                          </li>
                        )}
                      </ul>
                    )}
                    <p class="small">
                      <a href="#kontakt">Mehr über {org.name}: Website, Adresse, weitere Kontakte ↑</a>
                    </p>
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })
    }

    <div class="container">
      <section class="detail__share" aria-labelledby="abschnitt-teilen">
        <h2 id="abschnitt-teilen" class="label">Diese Seite teilen</h2>
        <div class="detail__share-row">
          <input class="input" id="share-url" type="text" readonly value={pageUrl} aria-label="Link zu dieser Seite" />
          <button type="button" class="btn" data-copy-target="share-url" data-copied-label="Kopiert">
            Link kopieren
          </button>
        </div>
        <p class="small detail__hashtags">{settings.hashtags.join(' ')}</p>
      </section>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="weitere-titel">
        <div class="container">
          <div class="section__head">
            <p class="label">Ebenfalls betroffen</p>
            <h2 id="weitere-titel">Mehr aus {orgAreas.length === 1 ? `dem Bereich ${mainArea.label}` : 'diesen Bereichen'}</h2>
          </div>
          <TileGrid projects={related} />
          <p class="detail__all">
            <a href={url(`/einrichtungen/?bereich=${orgAreas.map((a) => a.slug).join(',')}`)}>
              Alle Projekte aus {orgAreas.length === 1 ? 'diesem Bereich' : 'diesen Bereichen'} <IconArrow />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <DonationBlock organisation={org.name} />
</Page>

<script>
  import { initCopyButtons } from '../../scripts/copy-link.ts';
  initCopyButtons();
</script>

<style>
  .detail__head {
    background: var(--area-bg);
    color: var(--area-fg);
    border-bottom: var(--line-strong) solid var(--color-ink);
    --focus-color: var(--color-ink);
  }

  .detail__head-inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-7);
  }

  .detail__back {
    margin-bottom: var(--space-4);
    font-weight: 800;
  }

  .detail__back a::before {
    content: '← ' / '';
  }

  .detail__name {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 900;
    line-height: 0.95;
    max-width: 18ch;
  }

  .detail__summary {
    font-size: var(--fs-lead);
    font-weight: 800;
    font-stretch: var(--stretch-semi);
  }

  .detail__toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .project__contact {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: var(--line) solid var(--color-ink);
  }

  .detail__about {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  @media (min-width: 64em) {
    .detail__about {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }

  .detail__logo img {
    width: 100%;
    max-width: 24rem;
    height: auto;
    border: var(--line-strong) solid var(--color-ink);
  }

  .detail__logo--logo img {
    padding: var(--space-6);
    background: var(--color-white);
  }

  .detail__placeholder {
    display: grid;
    place-items: center;
    max-width: 24rem;
    aspect-ratio: 1;
    background: var(--area-bg);
    color: var(--area-fg);
    border: var(--line-strong) solid var(--color-ink);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: 1;
  }

  .detail__credit {
    margin-top: var(--space-2);
    color: var(--color-muted);
  }

  .detail__text {
    display: grid;
    gap: var(--space-6);
  }

  .detail__section {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--line-strong) solid var(--color-ink);
  }

  .detail__links {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  /* One block per project */
  .project {
    border-top: var(--line-strong) solid var(--color-ink);
    scroll-margin-top: var(--space-4);
  }

  .project__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  @media (min-width: 64em) {
    .project__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .project__area {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .project__swatch {
    width: 1.25rem;
    height: 1.25rem;
    border: var(--line) solid var(--color-ink);
    background: var(--area-bg);
  }

  .project__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-left: var(--space-5);
    border-left: 0.75rem solid var(--area-bg);
  }

  .project__name {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
  }

  .project__amount {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .project__amount--text {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.05;
  }

  .project__per {
    font-size: 0.32em;
    letter-spacing: 0;
  }

  .project__later {
    font-weight: 800;
  }

  .project__source {
    color: var(--color-muted);
  }

  .project__body {
    display: grid;
    gap: var(--space-6);
  }

  .project__media img {
    width: 100%;
    height: auto;
    border: var(--line-strong) solid var(--color-ink);
  }

  .project__media--logo img {
    max-width: 20rem;
    padding: var(--space-5);
    background: var(--color-white);
  }

  .detail__quote {
    padding-left: var(--space-5);
    border-left: 0.5rem solid var(--color-ink);
  }

  .detail__quote p {
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 800;
    font-stretch: var(--stretch-semi);
    line-height: 1.12;
    max-width: 28ch;
  }

  .detail__share {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-7);
    padding: var(--space-5);
    border: var(--line-strong) solid var(--color-ink);
  }

  .detail__share-row {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40em) {
    .detail__share-row {
      grid-template-columns: 1fr auto;
    }
  }

  .detail__hashtags {
    color: var(--color-muted);
  }

  .detail__all {
    margin-top: var(--space-6);
    font-weight: 800;
  }
</style>
