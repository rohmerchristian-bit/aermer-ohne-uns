---
import { url } from '../lib/paths.ts';
import Page from '../layouts/Page.astro';
import BudgetFacts from '../components/BudgetFacts.astro';
import Timeline from '../components/Timeline.astro';
import TileGrid from '../components/TileGrid.astro';
import AreaLinks from '../components/AreaLinks.astro';
import DonationBlock from '../components/DonationBlock.astro';
import JoinCta from '../components/JoinCta.astro';
import IconArrow from '../components/icons/IconArrow.astro';
import { count, organisationCount, projectCount, projects, projectsWithAmount, settings, sortedForGrid, totalAmount } from '../data/index.ts';
import { formatEuro } from '../lib/format.ts';

const HOME_TILES = 8;
const tiles = sortedForGrid().slice(0, HOME_TILES);
---

<Page
  title="Ärmer ohne uns"
  description="Erlangen muss im Haushalt 2027 sparen. Hier zeigen Kultur-, Bildungs- und Sozialeinrichtungen, was durch die Kürzungen verloren geht."
>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="container hero__inner">
      <h1 id="hero-titel" class="hero__logo">
        <img src={url('/brand/logo.webp')} width="1200" height="1056" alt="Ärmer ohne uns" fetchpriority="high" />
      </h1>

      <div class="hero__content">

      {
        totalAmount > 0 ? (
          <div class="hero__total">
            <p class="hero__number" aria-hidden="true">
              <span data-count-to={totalAmount}>{formatEuro(totalAmount)}</span>
            </p>
            <p class="hero__subtitle">
              <span class="visually-hidden">{formatEuro(totalAmount)} </span>
              {settings.heroSubtitle}
            </p>
            <p class="hero__basis small">
              Summe der für 2027 geplanten Kürzungen bei {count(projectsWithAmount, 'Projekt', 'Projekten')}
              {projectsWithAmount < projectCount && ` mit Betragsangabe (von ${projectCount})`} aus{' '}
              {count(organisationCount, 'Einrichtung', 'Einrichtungen')} auf dieser Plattform.
            </p>
          </div>
        ) : (
          <div class="hero__total">
            <p class="hero__subtitle">
              Welche Angebote in Erlangen durch die Kürzungen im Haushalt 2027 verloren gehen – die ersten Einrichtungen
              tragen sich gerade ein.
            </p>
          </div>
        )
      }

      <div class="hero__actions">
        {
          projectCount > 0 && (
            <a class="btn" href={url('/einrichtungen/')}>
              {count(projectCount, 'betroffenes Projekt', 'betroffene Projekte')} ansehen <IconArrow />
            </a>
          )
        }
        <a class="btn btn--signal" href="#spenden">Jetzt spenden <IconArrow /></a>
      </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="worum-titel">
    <div class="container">
      <div class="section__head">
        <p class="label">Worum es geht</p>
        <h2 id="worum-titel">Erlangen muss sparen. Die Frage ist, wo.</h2>
        <p class="lead">
          Die Stadt muss im Haushalt 2027 Millionen einsparen. Die Vorschläge der Verwaltung treffen viele Angebote, die
          die Stadt lebenswert machen.
        </p>
      </div>
      <BudgetFacts />
      <h3 class="home__timeline-title">So geht es weiter</h3>
      <Timeline />
      <p class="home__more">
        <a href={url('/hintergrund/')}>Alle Zahlen und Quellen <IconArrow /></a>
      </p>
    </div>
  </section>

  {
    projectCount > 0 && (
      <section class="section" aria-labelledby="betroffene-titel">
        <div class="container">
          <div class="section__head home__grid-head">
            <p class="label">Betroffene</p>
            <h2 id="betroffene-titel">Was verloren geht</h2>
            <AreaLinks projects={projects} />
          </div>
          <TileGrid projects={tiles} />
          <p class="home__more">
            <a class="btn btn--outline" href={url('/einrichtungen/')}>
              Alle {count(projectCount, 'Projekt', 'Projekte')} von {count(organisationCount, 'Einrichtung', 'Einrichtungen')} <IconArrow />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <DonationBlock />

  <JoinCta />
</Page>

<script>
  import { initCountUp } from '../scripts/count-up.ts';
  initCountUp();
</script>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-8);
    border-bottom: var(--line-strong) solid var(--color-ink);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--space-7);
    }
  }

  /* The campaign logo on a neon block (logo itself stays black). */
  .hero__logo {
    display: grid;
    place-items: center;
    max-width: 34rem;
    aspect-ratio: 1;
    padding: clamp(1.25rem, 5vw, 3rem);
    background: var(--color-signal);
    border: var(--line-strong) solid var(--color-ink);
  }

  .hero__logo img {
    width: 100%;
    height: auto;
  }

  .hero__content {
    display: grid;
    gap: var(--space-6);
  }

  .hero__total {
    display: grid;
    gap: var(--space-3);
    max-width: 60rem;
  }

  .hero__number {
    font-size: clamp(3rem, 11vw, 9rem);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  .hero__number span {
    display: inline-block;
    background: var(--color-signal);
    padding-inline: 0.08em;
  }

  .hero__subtitle {
    font-size: clamp(1.375rem, 2.6vw, 2.25rem);
    font-weight: 800;
    font-stretch: var(--stretch-semi);
    line-height: 1.15;
    max-width: 30ch;
  }

  .hero__basis {
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .home__timeline-title {
    margin-block: var(--space-8) var(--space-6);
  }

  .home__more {
    margin-top: var(--space-6);
    font-weight: 800;
  }

  .home__grid-head {
    gap: var(--space-5);
  }
</style>
